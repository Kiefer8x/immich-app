# Copy to .env and edit. Never commit .env.

# Synology paths (adjust volume number / shared folder)
UPLOAD_LOCATION=/volume1/docker/immich/library
# Must be on a local volume (NOT a network share/SMB/NFS mount)
DB_DATA_LOCATION=/volume1/docker/immich/postgres

TZ=America/Chicago
IMMICH_VERSION=release

# Database credentials - used by BOTH immich-server and the postgres container.
# Password: only A-Za-z0-9 characters.
DB_USERNAME=postgres
DB_PASSWORD=change_me_to_a_random_alphanumeric_string
DB_DATABASE_NAME=immich
